# 复制为 .env 后填写；不要提交 .env。
# 7 台 Worker 服务器都使用相同的密钥和推理依赖配置。
WORKER_AUTH_TOKEN=replace-with-the-same-long-random-secret
WORKER_MAX_CONCURRENT=8
# 每个 Worker 对应一张 GPU；T4 基准为 1.0，异构 GPU 按实测持续吞吐比例设置。
WORKER_CAPACITY_WEIGHT_1=1.0
WORKER_CAPACITY_WEIGHT_2=1.0
WORKER_CAPACITY_WEIGHT_3=1.0
WORKER_CAPACITY_WEIGHT_4=1.0
WORKER_DRAIN_DELAY=5
WORKER_SHUTDOWN_TIMEOUT=90

TRITON_MAX_WORKERS=32
LOGIC_MAX_WORKERS=32
IO_MAX_WORKERS=8
INFER_BACKEND=fire

STRUCT_EMBEDDING_MODEL=http://<vlm-host>:<port>/v1
STRUCT_EMBEDDING_MODEL_NAME=Qwen2.5-VL-7B-Instruct
MILVUS_CLIENT=http://<milvus-host>:19530
MILVUS_DB_NAME=vsearch_clip
MILVUS_VECTOR_COLLECTION_NAME=vector
MILVUS_VECTOR_FILTER_COLLECTION_NAME=vector_filter
MILVUS_FACE_COLLECTION_NAME=face
MILVUS_PLATE_COLLECTION_NAME=plate
MILVUS_FACE_DATABASE_COLLECTION_NAME=face_database

EOS_ACCESS_KEY=replace-with-eos-access-key
EOS_SECRET_KEY=replace-with-eos-secret-key
EOS_ENDPOINT=https://<eos-endpoint>
EOS_BUCKET=replace-with-eos-bucket
OBJ_SAVE_PIC_LOCPATH=/ai/capture/back/search_pic

VLM_TIMEOUT=5
MODEL_TIMEOUT=5
VECTOR_TIMEOUT=5
IMAGE_VECTOR_URL=http://<image-vector-host>:<port>/v1
VLLM_BASE_URL=http://<vlm-host>:<port>/v1
SEARCH_VECTOR_URL=http://<search-vector-host>:<port>/v1
RERANKER_URL=http://<reranker-host>:<port>/v1/rerank/image-to-texts
